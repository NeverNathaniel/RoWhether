// Cloudflare Worker: serves the built app from ./dist and runs worker/index.js
// for /api/* (the suggestion form). Secrets are set in the Cloudflare
// dashboard, never in this file: ANTHROPIC_API_KEY, GITHUB_TOKEN,
// TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY. See README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rowhether",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "NeverNathaniel/RoWhether",
    "APP_ENV": "production"
  },
  // Per-connection limits on suggestions and dock reports. Periods can only
  // be 10 or 60 seconds.
  "ratelimits": [
    { "name": "SUGGEST_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ],
  // Production has no DB binding yet, so dock reports stay off there. Add a
  // production D1 database here to turn them on.
  "observability": { "enabled": true },

  // Worker Previews: every branch other than the production branch builds to
  // its own URL, <branch>-rowhether.<subdomain>.workers.dev, with these
  // settings instead of production's. The dev branch is the shared dev
  // instance. No secrets are set for Previews, so the suggestion form stays
  // hidden there and never files real issues.
  "previews": {
    "vars": {
      "GITHUB_REPO": "NeverNathaniel/RoWhether",
      "APP_ENV": "dev"
    },
    "ratelimits": [
      { "name": "SUGGEST_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
      { "name": "REPORT_LIMIT", "namespace_id": "1004", "simple": { "limit": 3, "period": 60 } }
    ],
    // Shared by every Preview. Schema changes go in migrations/ and are
    // applied with: npx wrangler d1 migrations apply PREVIEW_DB --remote -c wrangler.preview-migrations.jsonc
    "d1_databases": [
      { "binding": "DB", "database_name": "rowhether-dev", "database_id": "addc1e87-7b52-4e31-bf0e-efd30ff82e59", "migrations_dir": "migrations" }
    ]
  }
}
