# Cloudflare static asset headers.
# Security headers on every file the host serves. The Worker's own /api answers do
# not pass through this file. The policy lets the app talk to the hosts its sources
# ask, the town search and Turnstile, and nothing else. A new source host goes into
# connect-src before its adapter ships: test/csp.test.js fails until it does. The
# flood, marine and tides hosts are for adapters of later phases. The Turnstile
# entries follow Cloudflare's guidance and are checked on production once the
# suggestion form opens there.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://api.open-meteo.com https://air-quality-api.open-meteo.com https://flood-api.open-meteo.com https://marine-api.open-meteo.com https://api.weather.gov https://api.waterdata.usgs.gov https://api.water.noaa.gov https://api.tidesandcurrents.noaa.gov https://geocoding-api.open-meteo.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# Hashed build output never changes, so cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and its manifest must always be revalidated.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# The curated location files are not hashed, so a browser may keep one for an
# hour at most. The service worker precaches them.
/locations/*
  Cache-Control: public, max-age=3600
