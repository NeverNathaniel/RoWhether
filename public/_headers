# Cloudflare static asset headers.
# Hashed build output never changes, so cache it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and its manifest must always be revalidated.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# The curated location files are not hashed, so a browser may keep one for an
# hour at most. The service worker precaches them.
/locations/*
  Cache-Control: public, max-age=3600
